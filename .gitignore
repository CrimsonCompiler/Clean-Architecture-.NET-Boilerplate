## Ignore Visual Studio and JetBrains Rider temporary files, build results, and
## files generated by popular IDE add-ons.

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/
.vs/

# JetBrains Rider cache/options directory
.idea/
*.sln.iml

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# SQLite Database files
*.db
*.db-journal
*.db-shm
*.db-wal
cleanarch.db

# NuGet Packages
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.[Tt]est.[Ll]og.*

# OS files
.DS_Store
Thumbs.db

# Environment variables and secrets
.env
*.env